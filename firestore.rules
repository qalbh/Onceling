rules_version = '2';

// Onceling — Firestore Security Rules.
//
// The client is untrusted. Only collections with an explicit match block are
// reachable; everything else falls through to the deny-all at the bottom.
//
// Collections so far: users (P2-30), pairingCodes (P2-08), pairingRequests
// (P2-09), rateLimits (P2-27), couples (P2-09b), items and secretBodies
// (P2-10). Rules land before the feed reads them, so P2-12 is built against a
// closed collection rather than bolting one shut afterwards.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The six client keys all present and typed. `pairingCode` and
    // `onboardingSeenAt` are server-written (by `ensurePairingCode` and
    // `markOnboardingSeen`, both admin, both bypassing rules) — hasOnly admits
    // them so a later client profile edit is not rejected for carrying them
    // along, and `fieldUnchanged` on the update rule is what stops a client
    // introducing or changing either.
    //
    // **Admitting them is not optional here**, unlike the equivalent case on
    // `items`: that validator runs on create only, so a server-written key it
    // omits is harmless. This one runs on UPDATE too, so any key the server
    // adds and this list omits would break every legitimate profile edit for
    // every user who has the field.
    function isWellFormedProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'avatarUrl', 'coupleId',
               'favoriteEmojis', 'accentColor', 'createdAt', 'pairingCode',
               'onboardingSeenAt', 'pushToken', 'pushTokenUpdatedAt',
               'notificationPreviews', 'milestoneSeen'
             ])
             && data.keys().hasAll([
                  'displayName', 'avatarUrl', 'coupleId',
                  'favoriteEmojis', 'accentColor', 'createdAt'
                ])
             && data.displayName is string
             && data.displayName.size() > 0
             && data.displayName.size() <= 40
             && (data.avatarUrl == null
                 || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
             && (data.coupleId == null
                 || (data.coupleId is string && data.coupleId.size() <= 128))
             && data.favoriteEmojis is list
             && data.favoriteEmojis.size() <= 8
             && (data.accentColor == null
                 || (data.accentColor is string
                     && data.accentColor.size() <= 16))
             && data.createdAt is timestamp
             && (!('onboardingSeenAt' in data)
                 || data.onboardingSeenAt == null
                 || data.onboardingSeenAt is timestamp)
             // **P3-04.** Unlike the two server-owned fields above, the client
             // WRITES this one and must be able to change it — FCM rotates
             // tokens without asking, and clearing it on sign-out is the whole
             // point (a stale token follows an account onto a handset somebody
             // else is holding). So it is bounded and typed here rather than
             // pinned with fieldUnchanged.
             //
             // Safe because it grants no data the writer does not already
             // have — NOT because the blast radius is their own device. A
             // member could write a third party's token here and have their
             // partner's notifications delivered elsewhere; they can already
             // read every one of those messages and forward them by hand, so
             // this is a convenience, not an escalation. §10 holds either way:
             // a secret's notification carries no body by construction, so the
             // redirected device learns a secret exists and nothing more.
             && (!('pushToken' in data)
                 || data.pushToken == null
                 || (data.pushToken is string
                     && data.pushToken.size() > 0
                     && data.pushToken.size() <= 4096))
             && (!('pushTokenUpdatedAt' in data)
                 || data.pushTokenUpdatedAt == null
                 || data.pushTokenUpdatedAt is timestamp)
             // Whether a lock screen may show message content (**P3-04**).
             // The person's own preference, so they must be able to change it —
             // no fieldUnchanged. Absent means off, the default the fan-out
             // already assumes.
             //
             // Caught by the audit: `notify.ts` read this field before the
             // rules admitted it, which made the "setting" unreachable and
             // previews permanently off. It failed in the safe direction, but
             // the code was claiming a choice the data layer did not allow.
             && (!('notificationPreviews' in data)
                 || data.notificationPreviews == null
                 || data.notificationPreviews is bool)
             // The highest milestone day this person has SEEN the full-screen
             // moment for (**P3-03**). Client-writable like pushToken, and for
             // the same shape of reason: it is a fact about this person's own
             // viewing, the server cannot know it, and forging it costs the
             // forger only their own celebration. What it can NOT forge is the
             // milestone itself — `milestoneCelebrated` lives on the couple
             // document, which is closed to client writes entirely.
             // Bounded so it cannot become a free integer channel.
             && (!('milestoneSeen' in data)
                 || data.milestoneSeen == null
                 || (data.milestoneSeen is int
                     && data.milestoneSeen >= 0
                     && data.milestoneSeen <= 100000));
    }

    // The caller's couple, read from their own profile.
    //
    // COST: one document read per request. Rule `get()` results are cached for
    // the duration of a single request, so a 30-item page costs one read, not
    // thirty. That is the cheapest correct shape available today.
    //
    // The cheaper alternative is a custom auth claim carrying coupleId, which
    // costs nothing to evaluate — but a claim is stale until the token
    // refreshes, so a freshly-paired or freshly-unpaired user would keep the
    // old access for up to an hour. For a field whose whole job is to be
    // authoritative about who may read a couple's messages, a stale copy is
    // the wrong trade. Revisit if read volume makes it matter.
    function myCoupleId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.coupleId;
    }

    // Membership, by comparing the document's couple to the caller's own.
    // A null coupleId matches nothing: an unpaired user is a member of no
    // couple, and `null == null` must never grant access to unscoped rows.
    function isCoupleMember(coupleId) {
      return isSignedIn()
             && coupleId is string
             && myCoupleId() == coupleId;
    }

    /// The five fields every item carries, whatever its type.
    function baseItemKeys() {
      return ['coupleId', 'senderId', 'type', 'createdAt', 'reactions'];
    }

    /// The exact key set a given type may carry.
    ///
    /// Per-type rather than a union of everything: a union let a `text` item
    /// arrive carrying `secretState`, which the P2-06 mapper would silently
    /// ignore while the document claimed to be something it is not. Caught by
    /// probe, not by reading.
    ///
    /// **`openingStartedAt` is deliberately absent**, even though **P3-01**'s
    /// Admin SDK writes it and a stored secret therefore carries a key this
    /// list does not name. Adding it was tried and reverted: it makes
    /// `openingStartedAt: null` writable by a client, trading a live guarantee
    /// — no client may stamp a reveal start time, in any form — for a purely
    /// hypothetical one. `items_rules.test.mjs` pins both directions.
    ///
    /// The consequence to know about: `isWellFormedItem` runs on create only,
    /// which is why reactions on an opened secret still work. **Do not add it
    /// to `allow update` as a hardening measure** — the stored shape would fail
    /// `hasOnly` and every reaction on a secret would start being rejected.
    function itemKeysFor(type) {
      return type == 'text'
               ? baseItemKeys().concat(['body'])
               : type == 'photo'
                 ? baseItemKeys().concat(['mediaUrl', 'caption'])
                 : type == 'emoji'
                   ? baseItemKeys().concat(['emoji', 'count'])
                   : type == 'status'
                     ? baseItemKeys().concat(['body', 'emoji'])
                     : baseItemKeys().concat([
                         'secretState', 'revealDurationSeconds',
                         'openedAt', 'heldFullCountdown'
                       ]);
    }

    /// Every field a thread item may carry, typed and bounded.
    ///
    /// This content renders on the other person's screen, so every string is
    /// capped and every optional field is type-checked.
    function isWellFormedItem(data) {
      return data.keys().hasAll(baseItemKeys())
             && data.type in ['text', 'photo', 'emoji', 'status', 'secret']
             && data.keys().hasOnly(itemKeysFor(data.type))
             && data.createdAt is timestamp
             && data.reactions is map
             && data.reactions.size() <= 2
             && (!('body' in data) || data.body == null
                 || (data.body is string && data.body.size() <= 2000))
             && (!('mediaUrl' in data) || data.mediaUrl == null
                 || (data.mediaUrl is string && data.mediaUrl.size() <= 512))
             && (!('caption' in data) || data.caption == null
                 || (data.caption is string && data.caption.size() <= 300))
             && (!('emoji' in data) || data.emoji == null
                 || (data.emoji is string && data.emoji.size() <= 16))
             && (!('count' in data) || data.count == null
                 || (data.count is int && data.count > 0 && data.count <= 999))
             && (!('secretState' in data) || data.secretState == null
                 || data.secretState in ['sealed', 'opened'])
             && (!('revealDurationSeconds' in data)
                 || data.revealDurationSeconds == null
                 || (data.revealDurationSeconds is int
                     && data.revealDurationSeconds > 0
                     && data.revealDurationSeconds <= 3600))
             && (!('openedAt' in data) || data.openedAt == null
                 || data.openedAt is timestamp)
             && (!('heldFullCountdown' in data)
                 || data.heldFullCountdown == null
                 || data.heldFullCountdown is bool);
    }

    /// A reactions map: at most one entry per member, each a short string.
    function isWellFormedReaction(reactions) {
      return reactions is map
             && reactions.size() <= 2
             && (!(request.auth.uid in reactions)
                 || (reactions[request.auth.uid] is string
                     && reactions[request.auth.uid].size() > 0
                     && reactions[request.auth.uid].size() <= 16));
    }

    /// The item a secret body belongs to.
    function revealItem(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data;
    }

    /// True while a secret's reveal window is genuinely open.
    ///
    /// `opening` alone is not enough — an unbounded `opening` is `sealed` with
    /// a longer name, and brief §10 promises against retention, not just
    /// against the wrong reader.
    ///
    /// The bound IS expressible here: `duration.value()` accepts a value read
    /// from the document, not only a literal. Probed both ways — a fresh
    /// window reads, an expired one is denied.
    ///
    /// `untilClosed` used to be the exception: no `revealDurationSeconds`, so
    /// no clock, so it gated on state alone and stayed readable for as long as
    /// it stayed `opening`. **P3-01 closed that.** A reader who never finishes
    /// would otherwise leave a readable body on the server indefinitely, which
    /// is the retention §10 promises against — the wrong reader is only half of
    /// what that section guards.
    ///
    /// Both branches are bounded now, and the ceiling is the same hour
    /// `isWellFormedItem` already caps `revealDurationSeconds` at, so the
    /// invariant is uniform: **no reveal session outlasts an hour.** Enforced
    /// here rather than only in P3-01's sweep, so the body stops being readable
    /// at the hour mark rather than whenever the schedule next happens to run.
    ///
    /// An `opening` item with no start time is unreadable — fails closed.
    function isWithinRevealWindow(item) {
      return item.secretState == 'opening'
             && item.openingStartedAt is timestamp
             // The key must be tested for presence first: reading a missing
             // key from a map is an error in rules, not a false.
             // `untilClosed` writes it as null and an older document may omit
             // it entirely; both mean "no per-item clock", not "denied".
             && (('revealDurationSeconds' in item)
                   && item.revealDurationSeconds is int
                   ? request.time < item.openingStartedAt
                       + duration.value(item.revealDurationSeconds, 's')
                   : request.time < item.openingStartedAt
                       + duration.value(3600, 's'));
    }

    /// A secret body. The text itself is the only payload.
    function isWellFormedBody(data) {
      return data.keys().hasOnly(['coupleId', 'senderId', 'body', 'createdAt'])
             && data.keys().hasAll(['coupleId', 'senderId', 'body', 'createdAt'])
             && data.body is string
             && data.body.size() > 0
             && data.body.size() <= 2000
             && data.createdAt is timestamp;
    }

    // Field unchanged between existing and incoming, treating absent as null.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    match /users/{uid} {
      // Only the owner, permanently. A partner never reads the other's profile:
      // **M-02** denormalises display names onto `couples/{id}.memberNames`,
      // which is members-only, so there is no reason to widen this and every
      // reason not to — a rule permitting "anyone paired with me" would be a
      // surface an enumerator can create at will.
      allow get: if isOwner(uid);

      // No listing: there is no query the app makes over the collection, and
      // allowing one would turn users/ into a directory of every account.
      allow list: if false;

      // Closed since P2-35. The profile is written only by the
      // `ensureUserProfile` callable, which runs with admin privileges and
      // bypasses these rules.
      //
      // This is a tightening, not a convenience. The client used to create its
      // own profile with `coupleId: null`, which is the wrong answer for
      // someone a couple still lists — and the client cannot compute the right
      // one, because it can neither query `couples` nor write `coupleId`. With
      // the write server-side there is no reason to leave the door open.
      allow create: if false;

      // Not a flat field deny: Firestore evaluates the whole resulting
      // document, so a legitimate displayName edit carries coupleId along with
      // it. Unchanged is fine; different is rejected — in either direction,
      // because an unrestricted clear orphans a couple just as surely as an
      // unrestricted set forges one.
      allow update: if isOwner(uid)
                    && isWellFormedProfile(request.resource.data)
                    && request.resource.data.coupleId == resource.data.coupleId
                    && request.resource.data.createdAt == resource.data.createdAt
                    // Like coupleId: server-owned in both directions. Carrying
                    // it along unchanged is fine; setting, changing or
                    // clearing it is not.
                    && fieldUnchanged('pairingCode')
                    // **PI-02.** The record that a required disclosure was
                    // made. §10 calls overclaiming here a regulatory risk, and
                    // evidence the client can author is weaker evidence — so
                    // `markOnboardingSeen` stamps it and nothing else may.
                    && fieldUnchanged('onboardingSeenAt');

      // Account deletion is a server-side cascade, never a client dropping its
      // own row and orphaning everything that points at it.
      allow delete: if false;
    }

    // The code → owner lookup. Readable by nobody: knowing a code must not
    // reveal who owns it (P2-23 — B learns nothing about A until A accepts),
    // and the collection must not be enumerable. All access goes through the
    // callables, which run with admin privileges.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // The handshake. Both ends may read their own requests; nobody writes —
    // every mutation is a callable (request, cancel, and later respond).
    match /pairingRequests/{requestId} {
      allow get: if isSignedIn()
                 && (request.auth.uid == resource.data.fromUid
                     || request.auth.uid == resource.data.toUid);

      // list allowed, but Firestore only grants a query that PROVABLY stays
      // inside this rule — a filter on fromUid == uid or toUid == uid. An
      // unfiltered or someone-else's query is rejected wholesale. Allowed
      // rather than denied because P2-24 (waiting state) and P2-25 (incoming
      // requests) both need to watch these as queries.
      allow list: if isSignedIn()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);

      allow create, update, delete: if false;
    }

    // The couple itself. Members read it; nobody writes it from a client —
    // it is created by P2-09b's accept transaction and mutated only by later
    // Functions (streaks P3-02, unpair). memberIds is the membership record
    // the whole product rests on, so a client that could edit it could write
    // itself into someone else's couple.
    match /couples/{coupleId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // No list: there is no query the app makes over couples, and allowing
      // one would expose every couple's membership to enumeration.
      allow list: if false;

      allow create, update, delete: if false;
    }

    // The thread (**P2-10**). User-authored content that renders on the other
    // person's screen, so every field is treated as untrusted.
    match /items/{itemId} {
      // Both scoped to the caller's couple. `list` is allowed rather than
      // denied because P2-12 needs an ordered, paginated, live query — a flat
      // deny would force reads by id, which a feed cannot do.
      //
      // Firestore evaluates this per returned document and fails the whole
      // query if any row fails, so an unfiltered or wrongly-scoped query is
      // rejected wholesale. The client must filter on its own coupleId.
      allow get, list: if isCoupleMember(resource.data.coupleId);

      allow create: if isCoupleMember(request.resource.data.coupleId)
                    // You may only speak as yourself.
                    && request.resource.data.senderId == request.auth.uid
                    && isWellFormedItem(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    // Nobody has reacted to a message that does not exist yet.
                    && request.resource.data.reactions.size() == 0;

      // Reactions are the only mutable field, and only your own entry in them.
      //
      // Both halves are expressible: affectedKeys() on the document restricts
      // WHICH field may change, and MapDiff.affectedKeys() on the reactions
      // map restricts WHICH KEY inside it. Without the second, any member
      // could rewrite their partner's reaction — or clear the map.
      allow update: if isCoupleMember(resource.data.coupleId)
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['reactions'])
                    && request.resource.data.reactions
                       .diff(resource.data.reactions)
                       .affectedKeys().hasOnly([request.auth.uid])
                    && isWellFormedReaction(request.resource.data.reactions);

      // No delete-a-message feature exists, and brief §7 puts editing out of
      // scope for V1. Removal is server-side only: P3-01 for secret bodies,
      // P2-36's sweep on unpair. A client that could delete its own copy has
      // not deleted anything anyway.
      allow delete: if false;
    }

    // Secret bodies, keyed by item id (**P2-10**).
    //
    // Carries `coupleId` because P2-36's sweep must find orphans by couple:
    // items are otherwise the only handle on a body, and either side can be
    // deleted first. Carries `senderId` so creation binds to the sender
    // without a get() on an item that may not be committed yet.
    match /secretBodies/{itemId} {
      // The recipient, and only while the reveal window is open (brief §10).
      //
      // Not "while sealed": that would mean every unopened secret, forever,
      // which guards against the wrong reader but not against retention.
      // `opening` is a real state (P2-06) with a start time, and the window is
      // bounded here against request.time.
      //
      // COST: one extra get() on the item, on top of the profile read.
      allow get: if isCoupleMember(resource.data.coupleId)
                 && resource.data.senderId != request.auth.uid
                 && isWithinRevealWindow(revealItem(itemId));

      // No listing, ever. A body is fetched by the id of the item being
      // opened; enumerating them is the whole thing brief §10 forbids.
      allow list: if false;

      allow create: if isCoupleMember(request.resource.data.coupleId)
                    && request.resource.data.senderId == request.auth.uid
                    && isWellFormedBody(request.resource.data)
                    && request.resource.data.createdAt == request.time;

      // A body is written once and never edited. Deletion is P3-01's Function
      // and P2-36's sweep — never a client.
      allow update, delete: if false;
    }

    // Request-budget counters. No client access in any direction: readable
    // counters would tell an enumerator exactly when probing is free again,
    // and writable ones would let them refill their own budget.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
