rules_version = '2';

// Onceling — Firestore Security Rules.
//
// The client is untrusted. Only collections with an explicit match block are
// reachable; everything else falls through to the deny-all at the bottom.
//
// Collections so far: users (P2-30), pairingCodes (P2-08), pairingRequests
// (P2-09), rateLimits (P2-27), couples (P2-09b). items and secretBodies
// arrive with their own rules at P2-12.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The six client keys all present and typed; pairingCode is the seventh,
    // written only by the ensurePairingCode callable (admin, bypasses rules) —
    // hasOnly admits it so a later client profile edit is not rejected for
    // carrying it, but nothing lets a client introduce or change it.
    function isWellFormedProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'avatarUrl', 'coupleId',
               'favoriteEmojis', 'accentColor', 'createdAt', 'pairingCode'
             ])
             && data.keys().hasAll([
                  'displayName', 'avatarUrl', 'coupleId',
                  'favoriteEmojis', 'accentColor', 'createdAt'
                ])
             && data.displayName is string
             && data.displayName.size() > 0
             && data.displayName.size() <= 40
             && (data.avatarUrl == null
                 || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
             && (data.coupleId == null
                 || (data.coupleId is string && data.coupleId.size() <= 128))
             && data.favoriteEmojis is list
             && data.favoriteEmojis.size() <= 8
             && (data.accentColor == null
                 || (data.accentColor is string
                     && data.accentColor.size() <= 16))
             && data.createdAt is timestamp;
    }

    // Field unchanged between existing and incoming, treating absent as null.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    match /users/{uid} {
      // Only the owner. A partner reading the other's profile arrives with the
      // couple model (P2-12) and will be scoped by coupleId, not opened here.
      allow get: if isOwner(uid);

      // No listing: there is no query the app makes over the collection, and
      // allowing one would turn users/ into a directory of every account.
      allow list: if false;

      // A new account starts unpaired, always. coupleId is set only by
      // P2-09b's transaction, which runs with admin privileges and bypasses
      // these rules.
      allow create: if isOwner(uid)
                    && isWellFormedProfile(request.resource.data)
                    && request.resource.data.coupleId == null
                    // The code is claimed server-side after the profile
                    // exists; a client cannot mint one at create time.
                    && !('pairingCode' in request.resource.data)
                    && request.resource.data.createdAt == request.time;

      // Not a flat field deny: Firestore evaluates the whole resulting
      // document, so a legitimate displayName edit carries coupleId along with
      // it. Unchanged is fine; different is rejected — in either direction,
      // because an unrestricted clear orphans a couple just as surely as an
      // unrestricted set forges one.
      allow update: if isOwner(uid)
                    && isWellFormedProfile(request.resource.data)
                    && request.resource.data.coupleId == resource.data.coupleId
                    && request.resource.data.createdAt == resource.data.createdAt
                    // Like coupleId: server-owned in both directions. Carrying
                    // it along unchanged is fine; setting, changing or
                    // clearing it is not.
                    && fieldUnchanged('pairingCode');

      // Account deletion is a server-side cascade, never a client dropping its
      // own row and orphaning everything that points at it.
      allow delete: if false;
    }

    // The code → owner lookup. Readable by nobody: knowing a code must not
    // reveal who owns it (P2-23 — B learns nothing about A until A accepts),
    // and the collection must not be enumerable. All access goes through the
    // callables, which run with admin privileges.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // The handshake. Both ends may read their own requests; nobody writes —
    // every mutation is a callable (request, cancel, and later respond).
    match /pairingRequests/{requestId} {
      allow get: if isSignedIn()
                 && (request.auth.uid == resource.data.fromUid
                     || request.auth.uid == resource.data.toUid);

      // list allowed, but Firestore only grants a query that PROVABLY stays
      // inside this rule — a filter on fromUid == uid or toUid == uid. An
      // unfiltered or someone-else's query is rejected wholesale. Allowed
      // rather than denied because P2-24 (waiting state) and P2-25 (incoming
      // requests) both need to watch these as queries.
      allow list: if isSignedIn()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);

      allow create, update, delete: if false;
    }

    // The couple itself. Members read it; nobody writes it from a client —
    // it is created by P2-09b's accept transaction and mutated only by later
    // Functions (streaks P3-02, unpair). memberIds is the membership record
    // the whole product rests on, so a client that could edit it could write
    // itself into someone else's couple.
    match /couples/{coupleId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // No list: there is no query the app makes over couples, and allowing
      // one would expose every couple's membership to enumeration.
      allow list: if false;

      allow create, update, delete: if false;
    }

    // Request-budget counters. No client access in any direction: readable
    // counters would tell an enumerator exactly when probing is free again,
    // and writable ones would let them refill their own budget.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
